# Copier dans .env (ignoré par Git) ; ne jamais committer de vraies valeurs.
AISSTREAM_API_KEY=
# Définir un mot de passe fort dans un .env local non suivi AVANT docker compose up.
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
# Renseigner le même mot de passe (encodé URL si caractères spéciaux).
DATABASE_URL=postgresql://ais_user:REPLACE_LOCALLY@127.0.0.1:5432/ais_pipeline
HF_TOKEN=
# Réservé à une future étape ; ne pas publier sans contrôle documenté.
HF_DATASET_REPO=
