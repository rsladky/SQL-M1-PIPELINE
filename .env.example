# Copier dans .env (ignoré par Git) ; ne jamais committer de vraies valeurs.
AISSTREAM_API_KEY=
# Exemple uniquement : définir un mot de passe fort hors Git avant démarrage de PostgreSQL.
DATABASE_URL=postgresql://ais_user:CHANGE_ME@localhost:5432/ais_pipeline
HF_TOKEN=
# Réservé à une future étape ; ne pas publier sans contrôle documenté.
HF_DATASET_REPO=
